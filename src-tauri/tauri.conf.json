{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agora",
  "version": "0.3.0",
  "identifier": "app.agora.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agora",
        "width": 1320,
        "height": 840,
        "minWidth": 720,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://agora.localhost http://armos.localhost agora: armos:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNkE5Q0REMUQ5NjlBN0QKUldSOW1wWWQzWnhxTU9vSVg4U0lNRm5sSnl5Zm5nRGhCVTZQMWZPcW9BY1czYk5LSHo3N3htOVYK",
      "endpoints": ["https://github.com/nicoborghi/agora/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
